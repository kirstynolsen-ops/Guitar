# Configure in Render Environment. Never commit real credentials.
APP_URL=https://your-service.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TEACHER_EMAILS=teacher@example.edu
STORAGE_PROVIDER=drive
# Generated by Connect Google Drive in the teacher workspace:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Enable the Google Drive file picker (optional for ordinary uploads):
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=
# Alternative filesystem provider only: STORAGE_PROVIDER=disk plus a mounted disk.
# DATA_DIR=/var/data/guitar-studio
